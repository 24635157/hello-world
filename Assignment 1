import pandas as pd

doc = []
with open('assets/dates.txt') as file:
    for line in file:
        doc.append(line)

df = pd.Series(doc)
df.head(10)
import re
from datetime import datetime

def date_sorter():
    def extract_date(text):
        def parse_month(month_str):
            month_map = {
                'jan': 1, 'january': 1,
                'feb': 2, 'february': 2,
                'mar': 3, 'march': 3,
                'apr': 4, 'april': 4,
                'may': 5,
                'jun': 6, 'june': 6,
                'jul': 7, 'july': 7,
                'aug': 8, 'august': 8,
                'sep': 9, 'sept': 9, 'september': 9,
                'oct': 10, 'october': 10,
                'nov': 11, 'november': 11,
                'dec': 12, 'december': 12
            }
            return month_map.get(month_str.lower().replace('.', ''), 1)

        patterns = [
            (r'\b(\d{1,2})/(\d{1,2})/(\d{2,4})\b', 'mdy_slash'),
            (r'\b(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec|January|February|March|April|May|June|July|August|September|October|November|December)[.]?[- ](\d{1,2})[-, ](\d{4})\b', 'month_day_year'),
            (r'\b(\d{1,2}) (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec|January|February|March|April|May|June|July|August|September|October|November|December)[.]?,? (\d{4})\b', 'day_month_year'),
            (r'\b(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec|January|February|March|April|May|June|July|August|September|October|November|December)[.]? (\d{4})\b', 'month_year'),
            (r'\b(\d{1,2})/(\d{4})\b', 'month_year_slash'),
            (r'\b(19\d{2}|20\d{2})\b', 'year_only')
        ]

        all_matches = []
        for pattern, pattern_type in patterns:
            for match in re.finditer(pattern, text, re.IGNORECASE):
                groups = match.groups()
                try:
                    parsed_date = None
                    if pattern_type == 'mdy_slash':
                        month, day, year = map(int, groups)
                        if year < 100:
                            year += 1900
                        parsed_date = datetime(year, month, day)
                    elif pattern_type == 'month_day_year':
                        month_str, day, year = groups
                        month = parse_month(month_str)
                        parsed_date = datetime(int(year), month, int(day))
                    elif pattern_type == 'day_month_year':
                        day, month_str, year = groups
                        month = parse_month(month_str)
                        parsed_date = datetime(int(year), month, int(day))
                    elif pattern_type == 'month_year':
                        month_str, year = groups
                        month = parse_month(month_str)
                        parsed_date = datetime(int(year), month, 1)
                    elif pattern_type == 'month_year_slash':
                        month, year = map(int, groups)
                        parsed_date = datetime(year, month, 1)
                    elif pattern_type == 'year_only':
                        year = int(groups[0])
                        parsed_date = datetime(year, 1, 1)

                    if parsed_date:
                        all_matches.append((match.start(), parsed_date))
                except Exception:
                    continue

        if all_matches:
            all_matches.sort(key=lambda x: x[0])
            return all_matches[0][1]
        return None

    extracted_dates = []
    for i, text in enumerate(df):
        date_obj = extract_date(str(text))
        if date_obj:
            extracted_dates.append((date_obj, i))
        else:
            extracted_dates.append((datetime(1900, 1, 1), i))

    extracted_dates.sort(key=lambda x: (x[0], x[1]))
    sorted_indices = [idx for _, idx in extracted_dates]
    return pd.Series(sorted_indices, dtype=int)

# Run it
result = date_sorter()

# Show results
print("Result shape:", result.shape)
print("Result dtype:", result.dtype)
print("First 10 results:", result.head(10).tolist())
print("Last 10 results:", result.tail(10).tolist())
